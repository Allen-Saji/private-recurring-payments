{
  "name": "private-recurring-funding",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --test test/*.test.mjs",
    "dev:landing": "vite --config landing/vite.config.ts",
    "build:landing": "tsc -p landing/tsconfig.json && vite build --config landing/vite.config.ts",
    "preview:landing": "vite preview --config landing/vite.config.ts",
    "build:billing": "tsc -p billing/tsconfig.json && vite build --config billing/vite.config.ts",
    "serve:billing": "node billing/server.mjs",
    "test:billing": "node --test billing/*.test.mjs",
    "build:product": "tsc -p product.tsconfig.json && vite build --config product.vite.config.ts"
  },
  "dependencies": {
    "@noir-wallet/sdk": "0.1.9",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
